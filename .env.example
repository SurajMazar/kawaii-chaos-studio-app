# Kawaii Chaos Studio — environment variables (copy to .env; never commit .env).
# Everything has a sensible default for running on your own Mac with studio/run.sh; the values below are what a
# server deployment (Docker) needs. Environment variables always win over what is saved in the UI.

# ---------------------------------------------------------------- core
# development (default for run.sh) | production (Docker image default: no stack traces, JSON logs, Secure cookies,
# HSTS, setup screen needs the one-time code from the log, local-machine features off)
STUDIO_ENV=production
# Fernet key that encrypts stored secrets (S3/R2 keys, 2FA secrets). REQUIRED in production if you save keys in the UI
# or use two-factor sign-in. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (run.sh creates studio/.config/secret.key automatically for local use)
STUDIO_SECRET_KEY=
# During a key rotation: the previous key(s), comma separated, still decrypt (see DEPLOY.md → Rotating the key)
STUDIO_SECRET_KEY_OLD=
# Listen address/port (the Docker image listens on 0.0.0.0:8770; publish it only to your reverse proxy)
STUDIO_HOST=0.0.0.0
PORT=8770
# Comma-separated IPs of reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are trusted ("*" only if the
# container is reachable exclusively through the proxy)
STUDIO_TRUSTED_PROXIES=127.0.0.1

# ---------------------------------------------------------------- folders (the Docker image sets these)
# Server config: users DB, encrypted storage settings, app settings, secret.key fallback. Keep it private + backed up.
STUDIO_CONFIG_DIR=/config
# Content folder when STORAGE_BACKEND=local (holds projects/, music_videos/, upload/, references/, fonts/, …)
STUDIO_DATA_DIR=/data
# Thumbnail cache (safe to delete)
STUDIO_CACHE_DIR=/cache
# S3/R2 work cache: files that renders/reel builds need are pulled here, outputs pushed back (safe to delete)
STUDIO_WORKDIR=/work
STUDIO_CACHE_MAX_GB=20
# How often (seconds) the bucket listing is refreshed (changes made by other tools show up after this)
STUDIO_INDEX_TTL=30
# Python used for the repo scripts (the image's own python has numpy/opencv/pillow/scipy)
STUDIO_SCRIPT_PYTHON=/usr/local/bin/python

# ---------------------------------------------------------------- first admin (optional)
# With both set, the first admin is created at start-up when there are no users (never overwrites). Otherwise the
# app shows a one-time setup screen; in production it asks for a setup code printed in the server log, or this:
STUDIO_ADMIN_EMAIL=
STUDIO_ADMIN_PASSWORD=
STUDIO_SETUP_TOKEN=

# ---------------------------------------------------------------- storage (overrides Settings → Integrations)
# local | s3 | r2 | s3compat   (leave empty to manage it in the UI)
STORAGE_BACKEND=
S3_BUCKET=
# Optional folder inside the bucket, e.g. studio
S3_PREFIX=
# Amazon S3: the bucket region. Other S3-compatible: usually us-east-1. R2: ignored (always "auto").
S3_REGION=
# s3compat (MinIO, Backblaze B2, Wasabi …): https://… endpoint. Amazon S3: leave empty. R2: use R2_ACCOUNT_ID instead.
S3_ENDPOINT=
R2_ACCOUNT_ID=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO / most self-hosted services (empty = choose in the UI; any value here locks the UI field)
S3_FORCE_PATH_STYLE=
# true = downloads go straight from the bucket via 5-minute signed links (needs bucket CORS for browser fetches)
S3_PRESIGN_DOWNLOADS=
S3_PUBLIC_BASE_URL=
# DEV ONLY: allow http:// and private/loopback storage endpoints (e.g. a local MinIO). Metadata/link-local addresses
# (169.254.169.254 …) are always refused.
STUDIO_ALLOW_INSECURE_ENDPOINTS=0

# ---------------------------------------------------------------- sessions & security
# auto (Secure when the request is https or STUDIO_ENV=production) | true | false
STUDIO_COOKIE_SECURE=auto
STUDIO_SESSION_IDLE_MINUTES=720
STUDIO_SESSION_MAX_HOURS=336
# Strict-Transport-Security on https responses (default on in production)
STUDIO_HSTS=1
# Extra origins allowed to call the API with credentials (CORS). Empty = same origin only (recommended).
STUDIO_ALLOWED_ORIGINS=
# Request size limits
STUDIO_MAX_UPLOAD_MB=200
STUDIO_MAX_JSON_MB=8
# Pillow decompression-bomb guard
STUDIO_IMAGE_MAX_PIXELS=80000000
# Jobs (renders, reel builds, tools): running at once / active per user / starts per user per minute
STUDIO_MAX_JOBS=3
STUDIO_MAX_JOBS_PER_USER=4
STUDIO_JOB_STARTS_PER_MINUTE=30
# Features that touch the server's own file system (Downloads import, export folder, script-python setting).
# Default: on in development, off in production.
STUDIO_LOCAL_FEATURES=0

# ---------------------------------------------------------------- logging
# json (production default) | text
STUDIO_LOG_FORMAT=json
STUDIO_LOG_LEVEL=INFO

# ---------------------------------------------------------------- docker compose --profile minio (local S3 testing)
MINIO_ROOT_USER=kcsminio
MINIO_ROOT_PASSWORD=
MINIO_IMAGE=

# ---------------------------------------------------------------- pictures and voices
# Where the pictures come from by default: own (you draw them; hides the ChatGPT steps) | chatgpt (prompt + board)
STUDIO_ART_SOURCE=own
# ElevenLabs API key for character voices (Voiceover tab). Optional; can also be saved (encrypted) in Settings → Integrations.
ELEVENLABS_API_KEY=
